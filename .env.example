# AI script generation
OPENAI_API_KEY=
OPENAI_SCRIPT_MODEL=

# Durable job database (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Private object storage (S3-compatible / Cloudflare R2)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Existing Vercel Voiceover Studio endpoint.
# Must be set only after its MessagePack/Connect request contract is verified.
VOICEOVER_API_URL=
VOICEOVER_API_TOKEN=

# YouTube Data API OAuth (channel owner authorization required)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# API protection for private job creation
STUDIO_API_SECRET=

# Durable orchestration
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Publishing is deliberately off by default.
YOUTUBE_PUBLISHING_ENABLED=false
YOUTUBE_DEFAULT_PRIVACY_STATUS=private
